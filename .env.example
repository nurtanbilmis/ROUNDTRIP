# Copy this file to .env.local and fill in the values. Never commit real values.

# Private Solana RPC URL (e.g. Triton, Helius, QuickNode), including its API token.
# SERVER-SIDE ONLY: read by server.ts and the Vercel function api/rpc.ts.
# Never prefix it with VITE_, or it gets shipped to every visitor's browser.
# (TRITON_RPC_URL is also accepted, for older deployments.)
RPC_UPSTREAM_URL=""

# Jupiter API key from https://portal.jup.ag (used for swaps, quotes, prices and token search).
# Note: VITE_ variables are bundled into the browser code, so this key is public.
# Use a key whose rate limit you are comfortable sharing with all users.
VITE_JUP_API_KEY=""
