# Copy this file to .env.local and fill in the values. Never commit real values.
# On Vercel: add these under Settings -> Environment Variables instead, marked
# Sensitive, with BOTH Production and Preview ticked.

# --- Solana RPC (GRAPE: the Triton endpoint) -----------------------------------
# Private Solana RPC URL including its token (Triton, Helius, QuickNode, ...).
# SERVER-SIDE ONLY: read by server.ts and the Vercel function api/rpc.ts.
# Never prefix it with VITE_, or it gets shipped to every visitor's browser.
# (TRITON_RPC_URL is also accepted, for older deployments.)
RPC_UPSTREAM_URL="https://YOUR-ENDPOINT.rpcpool.com/YOUR-TRITON-TOKEN"

# Optional. The site address the proxy sends to the RPC provider as Origin/Referer,
# for providers that whitelist by domain. Defaults to the address the site is served on.
# RPC_ORIGIN="https://roundtrip.your-domain.example"

# --- Jupiter (swaps, quotes, prices, token search) -----------------------------
# API key from https://portal.jup.ag
# SERVER-SIDE ONLY: read by the /api/jup proxy (server.ts and api/jup.ts).
# Never prefix it with VITE_.
JUP_API_KEY="YOUR-JUPITER-API-KEY"

# --- Fallback only: browser calls the RPC directly ------------------------------
# Leave unset. Use it only if your RPC provider refuses calls from Vercel's servers
# ("Your IP or provider is blocked"). This URL becomes PUBLIC (bundled into the page),
# so lock it to your domain in the provider's dashboard. Requires a redeploy.
# VITE_PUBLIC_RPC_URL="https://YOUR-ENDPOINT.rpcpool.com/YOUR-TRITON-TOKEN"
